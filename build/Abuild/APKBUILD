# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=xfce4-terminal
pkgver=1.1.5
pkgrel=0
pkgdesc="Lightweight and easy to use terminal emulator"
url="https://xfce.org/"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
subpackages="$pkgname-lang"
depends="hicolor-icon-theme glib gtk3 vte3 pcre2 libxfce4ui libxfce4util xfconf"
depends_dev="exo-dev libxfce4ui-dev pcre2-dev vte3-dev"
makedepends="$depends_dev
    meson
    "
source="https://archive.xfce.org/src/apps/xfce4-terminal/${pkgver%.*}/xfce4-terminal-$pkgver.tar.xz
0001-add-meson-option-to-build-doc.patch
0002-remove-opening-file-manager-option.patch
"

build() {
    meson setup build \
        --prefix=/usr \
	    -Ddocs=false
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}
